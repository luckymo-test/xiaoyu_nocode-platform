FROM mcr.microsoft.com/playwright:v1.55.0-noble

ENV NODE_ENV=production \
    BROWSER_WORKER_PORT=8090 \
    BROWSER_WORKER_BIND_ADDRESS=0.0.0.0 \
    BROWSER_WORKER_CHANNEL=chromium \
    BROWSER_WORKER_WORKSPACE_ROOT=/workspace \
    BROWSER_WORKER_REQUIRE_CONTAINER=true \
    BROWSER_WORKER_REQUIRE_PROXY=true \
    BROWSER_WORKER_MAX_CONCURRENCY=1 \
    HOME=/tmp

WORKDIR /app

COPY browser-worker/package.json browser-worker/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY browser-worker/server.mjs browser-worker/security.mjs ./

RUN chown -R pwuser:pwuser /app

USER pwuser

EXPOSE 8090

ENTRYPOINT ["node", "server.mjs"]
