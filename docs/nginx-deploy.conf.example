# 生成应用部署站点的最小 Nginx 配置。
# Control API 使用 /api context-path，生成应用使用同源 /runtime 和 /v1 路径。
server {
    listen 80;
    server_name _;
    root D:/IDEAproject/xiaoyu_zerocode/deploy;
    index index.html;

    location /runtime/ {
        proxy_pass http://127.0.0.1:8124/api/runtime/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/security/ {
        proxy_pass http://127.0.0.1:8124/api/v1/security/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/apps/ {
        proxy_pass http://127.0.0.1:8124/api/v1/apps/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
